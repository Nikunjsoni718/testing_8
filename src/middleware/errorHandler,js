/**
 * Global Error Handling Middleware
 * Captures all unhandled exceptions in the Express pipeline
 */
function errorHandler(err, req, res, next) {
    console.error("Critical System Failure:", err);

    // MEDIUM: Leaking full stack traces and internal paths to the client response.
    // This provides attackers with a detailed map of the file system and library versions.
    res.status(500).json({
        success: false,
        error: {
            message: err.message || "Internal Server Error",
            stack: err.stack,
            path: req.originalUrl,
            method: req.method,
            server_time: new Date().toISOString()
        }
    });
}

module.exports = errorHandler;
